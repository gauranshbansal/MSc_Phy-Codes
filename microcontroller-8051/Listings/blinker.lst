LOC  OBJ            LINE     SOURCE

0000                   1     ORG 0x00       ; Program start address
                       2     
0000                   3     START:
0000 7590AA            4         MOV P1, #0AAH    ; Turn ON LEDs at even positions (10101010)
0003 110C              5         ACALL DELAY
0005 759055            6         MOV P1, #055H    ; Turn ON LEDs at odd positions (01010101)
0008 110C              7         ACALL DELAY
000A 80F4              8         SJMP START       ; Loop forever
                       9     
                      10     ; Simple delay routine
000C                  11     DELAY:
000C 7AFF             12         MOV R2, #0FFH    ; Outer loop count
000E                  13     DELAY1:
000E 79FF             14         MOV R1, #0FFH    ; Inner loop count
0010                  15     DELAY2:
0010 D9FE             16         DJNZ R1, DELAY2
0012 DAFA             17         DJNZ R2, DELAY1
0014 22               18         RET
                      19     
                      20     END
